PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Azure Configuration (Leave blank to run in mock/simulation mode locally)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
USE_MOCK_AZURE=true

# Cache Configuration
OPERATIONAL_CACHE_TTL_MS=900000
BILLING_CACHE_TTL_MS=86400000
