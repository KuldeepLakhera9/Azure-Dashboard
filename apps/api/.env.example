# Server & Environment
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Azure Subscription & Authentication
# Default target subscription for ADT-AI Training Foundation Operations Center
AZURE_SUBSCRIPTION_ID=f3834a10-6431-4a62-8a1b-738cb5629169

# Service Principal Credentials (optional - leave blank when using Azure CLI or Managed Identity)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_USE_MANAGED_IDENTITY=false

# Simulation Mode: Set to false once logged into Azure CLI (az login) or deployed with Managed Identity
USE_MOCK_AZURE=true

# Cache & Refresh Policy Configuration
AZURE_RESOURCE_REFRESH_INTERVAL_MINUTES=15
AZURE_COST_CACHE_TTL_HOURS=24
AZURE_COST_REFRESH_INTERVAL_HOURS=24
OPERATIONAL_CACHE_TTL_MS=900000
BILLING_CACHE_TTL_MS=86400000

# Microsoft Entra ID API Protection (Optional in local development)
AUTH_ENABLED=true
AZURE_AD_TENANT_ID=
AZURE_AD_API_CLIENT_ID=
AZURE_AD_AUDIENCE=api://adt-ai-ops-api
REQUIRED_SCOPE=Dashboard.Read
